[
 {"id": "e1s01", "text": "В нашу степь падает небо. Раз в месяц.", "speed": 1.12, "pitch": 1.0},
 {"id": "e1s02", "text": "Мы приезжаем первыми. Металл — это деньги.", "speed": 1.05, "pitch": 1.0},
 {"id": "e1s03", "text": "Но в этот раз ступень выбила из земли что-то старое.", "speed": 1.05, "pitch": 1.0},

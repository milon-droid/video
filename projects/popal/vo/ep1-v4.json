"pitch": 0.92,
"fx": "radio"
},
{
"id": "d1",
"text": "Так Макс и умер. Девственником.",
"speaker": 26,
"speed": 1.12
},
{
"id": "e1",
"text": "На том свете тоже очередь. Но Макс — избр+анный. Ему — без очереди.",
"speaker": 26,
"speed": 1.12
},
{
"id": "e2",
"text": "О, быстро!",
"speaker": 7,
"speed": 1.05
},
{
"id": "f1",
"text": "Перерождение. Мир — Эльд+ория. Не ной.",
"speaker": 49
},
{
"id": "g1",
"text": "Сила — один. Здоровье — один. Аура — ноль.",
"speaker": 26,
"speed": 1.12
},
{
"id": "g2",
"text": "Сила и здоровье растут с опытом. А аура — только от побед и эп+ичных моментов.",

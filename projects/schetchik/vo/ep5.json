[
 {"id": "e5s01", "text": "Регистратор Марата. Ровно год назад.", "speed": 0.9, "pitch": 0.9},
 {"id": "e5s02", "text": "Его последний заказ. Получатель — я.", "speed": 0.9, "pitch": 0.9},
 {"id": "e5s03", "text": "В ту ночь я разбился на трассе.", "speed": 0.9, "pitch": 0.9},
 {"id": "e5s04", "text": "Это мой братишка. Не повезу.", "speed": 0.9, "pitch": 0.84, "fx": "radio"},
 {"id": "e5s05", "text": "Я выжил, потому что Марат отменил мою смерть.", "speed": 0.92, "pitch": 0.9},
 {"id": "e5s06", "text": "Сегодня этот заказ вернулся.", "speed": 0.9, "pitch": 0.9},
 {"id": "e5s07", "text": "Прости, братишка. Год — это очень долго.", "speed": 0.8, "pitch": 0.8, "fx": "dead"},
 {"id": "e5s08", "text": "Довезу — умру. Отменю — стану как он.", "speed": 0.9, "pitch": 0.9},
 {"id": "e5s09", "text": "Водителю платят жизнью получателя. А получатель — я.", "speed": 0.95, "pitch": 0.9},
 {"id": "e5s11", "text": "Марат ушёл. Долг закрыт.", "speed": 0.86, "pitch": 0.9},
 {"id": "e5s13", "text": "Только сервис взял свою комиссию.", "speed": 0.88, "pitch": 0.9}
]

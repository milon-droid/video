[
 {"id": "e3s01", "text": "Вторая ночь. Заказ на пять часов чужой жизни.", "speed": 0.9, "pitch": 0.9},
 {"id": "e3s02", "text": "Заброшенная баня шахты. Он вышел из темноты.", "speed": 0.92, "pitch": 0.9},
 {"id": "e3s03", "text": "В зеркале — только свет его фонаря.", "speed": 0.9, "pitch": 0.9},
 {"id": "e3s04", "text": "Получателю восемьдесят один. Его часы станут моими.", "speed": 0.95, "pitch": 0.9},
 {"id": "e3s05", "text": "Бека... балам. Обернись. Это я.", "voice": "ru_RU-irina-medium", "speed": 0.8, "pitch": 0.96, "fx": "whisper"},
 {"id": "e3s06", "text": "Голос мамы. Но мама спит дома.", "speed": 0.9, "pitch": 0.9},
 {"id": "e3s07", "text": "Молодец.", "voice": "ru_RU-irina-medium", "speed": 0.7, "pitch": 0.6, "fx": "dead"},
 {"id": "e3s08", "text": "Старик открыл сам. Будто ждал сына тридцать лет.", "speed": 0.92, "pitch": 0.9},
 {"id": "e3s09", "text": "Его пять часов. Теперь — мои.", "speed": 0.9, "pitch": 0.9},
 {"id": "e3s10", "text": "Я не нажимал «принять».", "speed": 0.9, "pitch": 0.9},
 {"id": "e3s13", "text": "Адрес — мой дом. Там спит мама.", "speed": 0.88, "pitch": 0.9}
]

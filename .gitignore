# Промежуточные кадры и рендеры — не храним в git
**/frames/
**/render/
*.tmp
.DS_Store
node_modules/
__pycache__/

# Звук собирается из sfx.json (tools/sfx.py)
projects/*/assets/sfx.wav

# Библиотеки звуков (скачиваются tools/get-sfx.sh)
assets/sfx-library/

# Референсы: исходные видео и кадры не храним (авторские права, вес)
refs/**/source.*
refs/**/frames/
refs/**/list.txt

# Модели голосов для озвучки (скачиваются, большие)
assets/voices/

projects/*/assets/sfx_vo.wav
projects/*/assets/vo/

projects/*/out/*.mp4
projects/*/out/*.wav
projects/*/out/qa/
projects/*/assets/music-*.wav
projects/blackout/assets/drone*.wav
projects/blackout/out/*.mp4
projects/blackout/out/*.wav
projects/blackout/out/qa/
projects/popal/assets/music/
projects/*/remotion/public/*.wav
projects/*/out/raw*.mp4
# голоса персонажей (образцы для Qwen3-TTS) и принятая озвучка — храним, чтобы голоса не менялись между чатами
!assets/voices/
assets/voices/*
!assets/voices/qwen-ref/
!projects/popal/assets/vo/
projects/popal/assets/vo/*
!projects/popal/assets/vo/ep1v5/
!projects/popal/assets/vo/ep2/
projects/*/vo/*.log
